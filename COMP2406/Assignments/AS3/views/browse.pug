include header

section.shelter-select
  h2 Select a Shelter
  select#shelterDropdown
    option(value="") -- No Shelter Selected --
    each s in shelters
      option(value=s.id)= s.name

//- Pet Type Buttons = hidden by default
section#petTypeBar.pet-type-bar.hidden
  button(data-type="All") All
  button(data-type="Cat") Cats
  button(data-type="Dog") Dogs
  button(data-type="Bird") Birds
  button(data-type="Reptile") Reptiles
  button(data-type="Other") Other

section#petContainer.pet-grid

script(src="/js/browse.js")

include footer
