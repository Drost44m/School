include header

main.applications-main
  h1 Submitted Applications
  .applications-card
    table.applications-table
      thead
        tr
          th Date
          th Application ID
          th Shelter ID
          th Pet ID
          th Pet Type
          th Status
      tbody#applicationsTableBody
        each app in applications
          tr
            td= app.date
            td
              | #{app.applicationId}
              button.view-btn(data-id=app.applicationId) View
            td= app.shelterId
            td= app.petId
            td= app.petType
            td(class="status-" + app.status)
              select(class="status-select status-" + app.status data-id=app.applicationId)
                each st in ["Unprocessed", "Pending", "Approved", "Rejected"]
                  option(value=st selected=(st === app.status))= st

  .application-details-section
    .applications-card
      #applicationDetails
        .details-card.hidden
          table.details-layout
            tr
              td.details-col
                h4 Application Info
                p
                  strong Date Submitted:
                  |  
                  span#d-date
                p
                  strong Status:
                  |  
                  span#d-status
                p
                  strong Pet ID:
                  |  
                  span#d-petId
                p
                  strong Shelter ID:
                  |  
                  span#d-shelterId
              td.details-col
                h4 Pet Requested
                table.pet-requested-layout
                  tr
                    td.pet-text
                      p
                        strong Name:
                        |  
                        span#p-name
                      p
                        strong Type:
                        |  
                        span#p-type
                      p
                        strong Breed:
                        |  
                        span#p-breed
                      p
                        strong Age:
                        |  
                        span#p-age
                      p
                        strong Days at Shelter:
                        |  
                        span#p-days
                    td.pet-image-cell
                      img#p-image.pet-image(src="" alt="")
            tr
              td.details-col(colspan="2")
                h4 Applicant Information
                p
                  strong Name:
                  |  
                  span#a-name
                p
                  strong Email:
                  |  
                  span#a-email
                p
                  strong Phone:
                  |  
                  span#a-phone
                p
                  strong Address:
                  |  
                  span#a-address

                h4 Household Details
                p
                  strong Number of Residents:
                  |  
                  span#a-residents
                p
                  strong Current Pets:
                  |  
                  span#a-currentPets
                p
                  strong Experience Level:
                  |  
                  span#a-experience
                p
                  strong Pet Location:
                  |  
                  span#a-location

                h4 Support
                p
                  strong Donation:
                  |  $
                  span#a-donation

script(src="/js/applications.js")

include footer
