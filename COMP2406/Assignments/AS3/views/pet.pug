include header

section#petDetailsContainer
  if error
    p.error= error
  else
    .pet-detail-card
      img.pet-detail-image(src="/" + pet.image alt=pet.name)
      h2= pet.name
      p #{pet.age} year old #{pet.breed} (#{pet.type})
      p
        strong Health:
        |  #{pet.health}
      if pet.traits.length
        ul
          each t in pet.traits
            li= t
      else
        br
      p
        strong Days at Shelter:
        |  #{pet.daysAtShelter}
      p
        strong Views:
        |  #{pet.views}
      hr
      p
        strong Adoption Fee:
        |  $#{pet.adoptionFee}
      p
        strong Processing Fee:
        |  $#{processingFee}
      p
        strong Total (before taxes):
        |  $#{totalFee}
      a.apply-button(href="/apply?petId=" + pet.id + "&petName=" + encodeURIComponent(pet.name) + "&petType=" + encodeURIComponent(pet.type) + "&petBreed=" + encodeURIComponent(pet.breed) + "&adoptionFee=" + pet.adoptionFee + "&processingFee=" + processingFee + "&shelterId=" + shelterId) Apply to Adopt this Pet
if shelterId
  a#back-button
    a.back-link(href="/browse?shelterId=" + shelterId) Back to Browsing
else
  a#back-button
    a.back-link(href="/browse") Back to Browsing

include footer
