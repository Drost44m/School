[ T6/server.js, lines 7-14 ]  file extension -> Content-Type
```
const mimeTypes = {
    ".html": "text/html",
    ".css":  "text/css",
    ".js":   "application/javascript",
    ".png":  "image/png",
    ".jpg":  "image/jpeg",
    ".ico":  "image/x-icon"
};
```

[ T6/server.js, lines 21-39 ]  read a file with fs.readFile, 404 if missing, 500 for other errors
```
// Serve a static file
function serveStaticFile(filePath, response) {
    fs.readFile(filePath, (err, data) => {
        if (err) {
            if (err.code === "ENOENT") {
                response.writeHead(404);
                response.end("File Not Found");
            }
            else {
                response.writeHead(500);
                response.end("Cannot Read File");
            }
        } else {
            const ext = path.extname(filePath);
            response.writeHead(200, {'Content-Type': mimeTypes[ext]});
            response.end(data);
        }
    });
}
```
  - data is a Buffer, send it as is (do NOT toString() images).
  - err.code === "ENOENT" means the file does not exist.
  - path.extname("a/b/style.css") -> ".css", used to pick the Content-Type.

[ T6/server.js, lines 72-92 ]  GET: map pretty URLs to files, otherwise treat the pathname as the file path
```
    // Handle a GET request for an HTML page
    if (request.method === "GET") {
        const routes = {
            "/": "index.html",
            "/cart": "cart.html",
            "/menu": "menu.html",
            "/locations": "locations.html",
            "/contact": "contact.html",
